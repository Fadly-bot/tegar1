{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 10
    },
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/login.php", "destination": "/index.php" },
    { "source": "/((?!api/|assets/).*)", "destination": "/api/index.php" }
  ]
}
